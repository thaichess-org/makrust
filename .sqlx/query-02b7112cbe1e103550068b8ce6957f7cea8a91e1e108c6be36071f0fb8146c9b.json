  "query": "SELECT s.id as session_id, s.user_id, s.created_at as session_created_at,\n                      s.expires_at, s.revoked_at, u.username, u.last_seen_at\n               FROM sessions s\n               JOIN users u ON u.id = s.user_id\n               WHERE s.id = $1",
